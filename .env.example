# Plantilla de variables de entorno.
# Copia este archivo a «.env» y rellena tus claves. El archivo .env NO se sube a git.
ENV=development
VECTOR_DB_URL=

# =============================================================================
# PROVEEDOR DE LLM (ver llm_interface.py)
# El proyecto es agnóstico del proveedor. Elige uno con LLM_PROVIDER; si no se
# define, se usa "openai" (comportamiento histórico). Sin proveedor válido, el
# chat funciona igualmente en modo determinista (sin IA).
# =============================================================================
# LLM_PROVIDER = openai | anthropic | ollama | azure | compatible | null
LLM_PROVIDER=openai

# --- OpenAI oficial (por defecto) ---
API_OPENAI=tu_clave_de_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude (LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Endpoint compatible con OpenAI: Ollama, Azure, LM Studio, vLLM... ---
#   (LLM_PROVIDER=ollama|azure|compatible)
#   Ejemplo Ollama local:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Clave heredada (compatibilidad); OpenAIProvider también acepta OPENAI_API_KEY.
XAI_API_KEY=tu_clave_aqui
